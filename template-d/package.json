{
  "name": "pathil-car-rental-template",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i styles.css -o styles.generated.css --minify",
    "build:js": "esbuild main.jsx --bundle --minify --target=es2020 --outfile=app.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
